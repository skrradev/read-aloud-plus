{
  "manifest_version": 3,
  "name": "Read Aloud+ for Claude & ChatGPT",
  "version": "1.1.0",
  "description": "Highlights each word as Claude's or ChatGPT's Read aloud speaks it, and adds pitch-preserving speed control (0.5×–2.5×).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Read Aloud+ settings",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/aligner.js", "src/stretcher.js", "src/textmap.js", "src/core.js", "src/sites/claude.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["src/aligner.js", "src/textmap.js", "src/core.js", "src/sites/chatgpt.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://claude.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["src/defaults.js", "src/bridge.js"],
      "run_at": "document_start"
    }
  ]
}
